DATABASE_URL=sqlite:///./job_tracker.db

# Optional: auto-extract job fields (company, title, salary, etc.) from
# pasted job postings using an OpenAI-compatible chat completions API.
# Leave this section alone to run WITHOUT that feature — everything else
# in the app (manually adding/tracking applications) works fine without it.
#
# To enable it, point at any OpenAI-compatible endpoint you have access to,
# for example Ollama running locally on this Mac:
#   1. Install Ollama: https://ollama.com
#   2. ollama pull llama3.2
#   3. Uncomment the two lines below
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
#
# Or an OpenAI/Anthropic-compatible cloud API:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
